{
  "name": "feedclaw",
  "version": "0.1.3",
  "description": "RSS/Atom feed reader and AI digest builder CLI",
  "keywords": [
    "rss",
    "atom",
    "feed",
    "reader",
    "digest",
    "ai",
    "cli",
    "openclaw"
  ],
  "homepage": "https://github.com/psandis/feedclaw",
  "bugs": {
    "url": "https://github.com/psandis/feedclaw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psandis/feedclaw.git"
  },
  "license": "MIT",
  "author": "psandis",
  "type": "module",
  "bin": {
    "feedclaw": "dist/cli.js"
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "feeds"
  ],
  "scripts": {
    "cli": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@extractus/feed-extractor": "^8.0.3",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
